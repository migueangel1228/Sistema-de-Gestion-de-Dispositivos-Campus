        <mxCell id="l3_box" parent="1" value="3. CAPA DE LÓGICA DE NEGOCIO Y APLICACIÓN (Core Domain Services &amp; Security)" style="html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;rounded=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=13;fontColor=#0F172A;" vertex="1">
          <mxGeometry x="80" y="445" width="1540" height="185" as="geometry" />
        </mxCell>
        <mxCell id="srv_assign" parent="1" value="&lt;b&gt;Motor de Asignación y Factibilidad&lt;/b&gt;&lt;br&gt;• Dron: 0.1 - 2.0 kg (viento &amp;le; 25 km/h)&lt;br&gt;• Robot: 2.0 - 10.0 kg o contingencia&lt;br&gt;• Reserva energética &amp;ge; 10%" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="120" y="490" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="srv_telemetry" parent="1" value="&lt;b&gt;Motor de Telemetría Reactiva&lt;/b&gt;&lt;br&gt;• Frecuencia de rastreo: 1 Hz&lt;br&gt;• Detección desvío &gt; 10 m&lt;br&gt;• Pérdida enlace &gt; 15 s" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="420" y="490" width="260" height="115" as="geometry" />
        </mxCell>
        <mxCell id="srv_handover" parent="1" value="&lt;b&gt;Generador Seguro CSPRNG&lt;/b&gt;&lt;br&gt;• Token QR cifrado&lt;br&gt;• PIN numérico de 6 dígitos&lt;br&gt;• Vigencia 120 min (RF-22)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="710" y="490" width="260" height="115" as="geometry" />
        </mxCell>
        <mxCell id="srv_contingency" parent="1" value="&lt;b&gt;Coordinador de Contingencias&lt;/b&gt;&lt;br&gt;• Aborto por batería crítica (&amp;lt; 10%)&lt;br&gt;• Relevo automático por UGV (RF-32.4)&lt;br&gt;• Protocolo RTH (Return-To-Home)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="1000" y="490" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="srv_auth" parent="1" value="&lt;b&gt;Servicio de Acceso y RBAC&lt;/b&gt;&lt;br&gt;• Sesiones seguras (15 min)&lt;br&gt;• Bloqueo tras 5 intentos fallidos&lt;br&gt;• Validación federada SIU (RF-08)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.2;fontColor=#0F172A;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="1300" y="490" width="280" height="115" as="geometry" />
        </mxCell>
        <mxCell id="l4_box" parent="1" value="4. CAPA DE PERSISTENCIA, NUBE Y SERVICIOS EXTERNOS (BaaS &amp; External APIs)" style="html=1;whiteSpace=wrap;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=1.5;rounded=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=13;fontColor=#6B21A8;" vertex="1">
          <mxGeometry x="80" y="655" width="1540" height="175" as="geometry" />
        </mxCell>
        <mxCell id="ext_db" parent="1" value="&lt;b&gt;Supabase Database (PostgreSQL)&lt;/b&gt;&lt;br&gt;Esquema relacional con RLS&lt;br&gt;Usuarios, Reservas, Misiones y Auditoría" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.2;fontColor=#1E1B4B;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="120" y="700" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ext_s3" parent="1" value="&lt;b&gt;Supabase Storage (S3 Bucket)&lt;/b&gt;&lt;br&gt;Bucket &lt;i&gt;drone-videos&lt;/i&gt;&lt;br&gt;Retención estricta 30 días (RF-26)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.2;fontColor=#1E1B4B;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="410" y="700" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ext_siu" parent="1" value="&lt;b&gt;SIU (Directorio PUJ Cali)&lt;/b&gt;&lt;br&gt;API REST institucional&lt;br&gt;Validación solicitantes en tiempo real" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.2;fontColor=#1E1B4B;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="700" y="700" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ext_meteo" parent="1" value="&lt;b&gt;API Meteorológica (Open-Meteo)&lt;/b&gt;&lt;br&gt;Viento, rachas y lluvia&lt;br&gt;Interlock RAC 100 (viento &amp;le; 25 km/h)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.2;fontColor=#1E1B4B;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="990" y="700" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ext_notif" parent="1" value="&lt;b&gt;Servicio Notificaciones&lt;/b&gt;&lt;br&gt;SMS y Correo Institucional&lt;br&gt;Despacho de PIN y QR al solicitante" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.2;fontColor=#1E1B4B;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="1280" y="700" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="l5_box" parent="1" value="5. CAPA DE DISPOSITIVOS Y HARDWARE EN CAMPUS (Edge Fleet &amp; Autonomous Hardware)" style="html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;rounded=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=13;fontColor=#92400E;" vertex="1">
          <mxGeometry x="80" y="855" width="1540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="hw_dron" parent="1" value="&lt;b&gt;Flota de Drones (UAV)&lt;/b&gt;&lt;br&gt;• Carga útil: 0.1 a 2.0 kg&lt;br&gt;• Altura máxima: 120 m AGL (RAC 100)&lt;br&gt;• MAVLink / PX4 / Telemetría GPS abordo&lt;br&gt;• Cámara streaming HD + fail-secure" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontColor=#78350F;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="150" y="895" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="hw_robot" parent="1" value="&lt;b&gt;Flota de Robots Terrestres (UGV)&lt;/b&gt;&lt;br&gt;• Carga útil: 2.0 a 10.0 kg&lt;br&gt;• Navegación autónoma en campus (ROS2 / LiDAR)&lt;br&gt;• Tracción 4x4 y compartimiento seguro&lt;br&gt;• Relevo de misiones ante lluvia/viento" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontColor=#075985;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="580" y="895" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="hw_station" parent="1" value="&lt;b&gt;Centrales de Carga Automatizada&lt;/b&gt;&lt;br&gt;• Estaciones de acople inductivo en campus&lt;br&gt;• Monitoreo de estado ocupado/disponible&lt;br&gt;• Puntos estratégicos (Edificios Guayacanes, Samán)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1">
          <mxGeometry x="1040" y="895" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="notes_box" parent="1" value="&lt;b&gt;Reglas de Arquitectura y Estándares de Ingeniería:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ISO/IEC/IEEE 29148:2018:&lt;/b&gt; Trazabilidad de 16 requisitos funcionales (RF-01 a RF-34), 6 no funcionales (RNF-01 a RNF-14) y 5 de restricción (RR-01 a RR-05).&lt;br&gt;• &lt;b&gt;Aeronáutica Civil RAC 100:&lt;/b&gt; Operación de drones confinada al campus PUJ Cali, techo máximo de 120 m AGL, interlock meteorológico (viento &amp;le; 25 km/h, sin precipitación).&lt;br&gt;• &lt;b&gt;Criptografía &amp; Seguridad:&lt;/b&gt; Doble factor de entrega (PIN de 6 dígitos generado con CSPRNG + token QR con expiración de 120 min), sesiones con hash seguro y caducidad de 15 min.&lt;br&gt;• &lt;b&gt;Políticas de Datos:&lt;/b&gt; Bitácora inmutable en PostgreSQL, telemetría a 1 Hz, y grabaciones audiovisuales en Supabase Storage con retención y purga automática a los 30 días." style="html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=middle;rounded=1;fontSize=11;fontColor=#334155;spacingLeft=15;" vertex="1">
          <mxGeometry x="80" y="1040" width="1540" height="115" as="geometry" />
        </mxCell>
