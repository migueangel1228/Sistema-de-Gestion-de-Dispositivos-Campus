        <mxCell id="c2n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:14px&quot;&gt;Consola Web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: SPA - React 18 / Vite / Tailwind CSS / Leaflet]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Página que usan los administradores y la vigilancia: mapa en vivo, inventario, reservas, despacho, alertas, videos y reportes.&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="600" x="480" y="340" as="geometry" />
        </mxCell>
        <mxCell id="c2n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:14px&quot;&gt;API Backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Node.js + Express]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tiene la lógica del sistema: valida, asigna y despacha misiones, recibe la telemetría y genera alertas. Expone una API REST y un canal WebSocket.&lt;/span&gt;" vertex="1">
          <mxGeometry height="170" width="400" x="580" y="620" as="geometry" />
        </mxCell>
