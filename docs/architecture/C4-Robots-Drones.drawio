        <mxCell id="c3n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Controlador de Cuentas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Express Router]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Crea, edita y desactiva cuentas de administradores (RF-03).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="800" y="430" as="geometry" />
        </mxCell>
        <mxCell id="c3n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Controlador de Inventario y Mantenimiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Express Router]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Dispositivos, estados, parámetros y órdenes de mantenimiento (RF-04 a RF-07, RF-33, RF-34).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1050" y="430" as="geometry" />
