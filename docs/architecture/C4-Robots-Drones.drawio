        <mxCell id="c3n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Controlador de Autenticación&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Express Router]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Inicio y cierre de sesión y recuperación de contraseña (RF-01, RF-02).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="550" y="430" as="geometry" />
