        <mxCell id="c3n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Controlador de Reservas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Express Router]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Crea, modifica y cancela reservas y sugiere el siguiente horario (RF-08 a RF-13).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1300" y="430" as="geometry" />
        </mxCell>
        <mxCell id="c3n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Controlador de Despacho&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Express Router]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Asigna y despacha misiones y controla la cuota diaria (RF-14, RF-18, RF-19).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1550" y="430" as="geometry" />
        </mxCell>
        <mxCell id="c3n11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gestor de Alertas y Contingencias&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Express Router]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Detecta desvíos, caídas, pérdida de señal y batería baja, y registra la atención (RF-30 a RF-32).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1800" y="430" as="geometry" />
        </mxCell>
        <mxCell id="c3n12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Componente de Seguridad&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Middleware JWT + bcrypt]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Verifica contraseñas con bcrypt, bloquea 15 min tras 5 intentos fallidos y expira sesión por inactividad tras 15 min (RNF-01, RNF-02, RNF-16).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="550" y="700" as="geometry" />
        </mxCell>
        <mxCell id="c3n13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gestor de Videos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Servicio]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Inicia y detiene la grabación, sube el video y borra los de más de 30 días (RF-25 a RF-27).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="800" y="700" as="geometry" />
        </mxCell>
        <mxCell id="c3n14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Tareas Programadas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: node-cron]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Reinicia la cuota diaria a las 00:00, vence QR/PIN y limpia videos viejos.&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1050" y="700" as="geometry" />
        </mxCell>
        <mxCell id="c3n15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gestor de Entregas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Servicio]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Genera token QR y PIN criptográfico de 6 dígitos (CSPRNG) con vigencia de 120 min (2 h) de un solo uso (RF-22, RF-23, RNF-08).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1300" y="700" as="geometry" />
        </mxCell>
        <mxCell id="c3n16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Asignador de Dispositivos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Servicio]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Asigna dron UAV (0.1 a 2.0 kg con batería &gt;= 80% y clima favorable) o robot UGV (&gt; 2.0 kg hasta 10 kg o por contingencia climática) (RF-14 a RF-17).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1550" y="700" as="geometry" />
        </mxCell>
        <mxCell id="c3n17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Receptor de Telemetría&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: WebSocket]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Recibe ubicación, batería y sensores, los guarda y los manda en vivo a la consola (RF-20, RF-21).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1800" y="700" as="geometry" />
        </mxCell>
        <mxCell id="c3n18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Adaptador de Almacenamiento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Adaptador (RNF-12)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Gestiona bucket S3 en Supabase Storage (drone-videos) con política de retención estricta de 30 días para videos (RR-03, RF-26).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="800" y="970" as="geometry" />
        </mxCell>
        <mxCell id="c3n19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Adaptador de Notificaciones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Adaptador (RNF-12)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Envía estados de misión, tokens QR/PIN de entrega y órdenes de mantenimiento mediante Correo electrónico y SMS (RF-22, RF-33).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1050" y="970" as="geometry" />
        </mxCell>
        <mxCell id="c3n20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Adaptador SIU&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Adaptador (RNF-12)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Valida si el solicitante es miembro activo de la comunidad PUJ en tiempo real sin base de usuarios local (RR-05).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1300" y="970" as="geometry" />
        </mxCell>
        <mxCell id="c3n21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Adaptador de Mapas y Rutas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Adaptador (RNF-12)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Mapa base (OpenStreetMap/Leaflet), cálculo de waypoints entre edificios y validación de geocerca campus PUJ Cali (radio 480 m) (RR-04, RR-06).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1550" y="970" as="geometry" />
        </mxCell>
        <mxCell id="c3n22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;metaEdit=1;spacing=6;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:12px&quot;&gt;Adaptador de Clima y Meteorología&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Componente: Adaptador (RNF-12)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Consulta viento y lluvia en tiempo real. Aplica Falla Segura (Fail-Secure): si viento &gt; 25 km/h o lluvia, bloquea vuelo de dron y reasigna a UGV (RAC 100, RF-16).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1800" y="970" as="geometry" />
        </mxCell>
        <mxCell id="c3n23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:13px&quot;&gt;Supabase Storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo: Cloud Object Storage S3]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Almacena grabaciones de video de las misiones con retención de 30 días calendario (RR-03, RF-26).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="800" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="c3n24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" value="&lt;b style=&quot;font-size:13px&quot;&gt;Servicio de Notificaciones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo: Pasarela Email / SMS]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Envía avisos de estado, códigos OTP (QR/PIN) para validación de entregas y órdenes de mantenimiento (RF-22, RF-33).&lt;/span&gt;" vertex="1">
          <mxGeometry height="140" width="210" x="1050" y="1290" as="geometry" />
        </mxCell>
        <object label="&lt;b style=&quot;font-size:13px&quot;&gt;SIU (Directorio PUJ)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo: API REST Institucional]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Valida en tiempo real que el solicitante sea un miembro activo de la comunidad universitaria sin base local (RR-05, RF-08).&lt;/span&gt;" id="c3n25">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1">
