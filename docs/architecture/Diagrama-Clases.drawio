        <mxCell id="77X7TFaUozjecX6QZ6mQ-133" edge="1" parent="1" source="77X7TFaUozjecX6QZ6mQ-51" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=12;labelBackgroundColor=#ffffff;endSize=12;startSize=14;strokeColor=#333333;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" target="77X7TFaUozjecX6QZ6mQ-63" value="se carga en">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="77X7TFaUozjecX6QZ6mQ-134" connectable="0" parent="77X7TFaUozjecX6QZ6mQ-133" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;labelBackgroundColor=none;" value="0..*" vertex="1">
